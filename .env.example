# Template only. Recommended: run scripts/setup.mjs to generate a private .env.
# Use a different project name for independent installations on the same computer.
COMPOSE_PROJECT_NAME=moneta
POSTGRES_DB=moneta
POSTGRES_USER=moneta
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://moneta:replace-with-a-long-random-password@localhost:5432/moneta
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5180
PORT=3080
# Empty means Compose derives origins from BIND_ADDRESS and FRONTEND_PORT.
# For a custom local hostname, set a comma-separated list (no spaces).
ALLOWED_ORIGINS=
