{
  "name": "@moneta/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@moneta/shared": "workspace:*",
    "express": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "zod": "^4.1.13",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "drizzle-kit": "^0.31.7"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
